#!/bin/sh
# LAYERS pre-push gate. Enable with: bash scripts/install-hooks.sh
#
# This repo sets core.hooksPath to .githooks/ so the hook is versioned and runs
# straight from the working tree — nothing to copy into .git/hooks.
#
# Setting core.hooksPath per repo overrides the global one, so this script first
# delegates to the global hook (the shared changelog.d gate) and only then runs
# the guards that are specific to LAYERS.

set -u
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

# --- delegate to the global hook, if there is one -------------------------
global_hooks=$(git config --global --get core.hooksPath || true)
if [ -n "$global_hooks" ]; then
  # Expand a leading ~ the way git does.
  case "$global_hooks" in "~/"*) global_hooks="$HOME/${global_hooks#~/}" ;; esac
  if [ -x "$global_hooks/pre-push" ] && [ "$global_hooks/pre-push" != "$0" ]; then
    "$global_hooks/pre-push" "$@" </dev/null || exit 1
  fi
fi

fail=0
branch=$(git rev-parse --abbrev-ref HEAD)

# --- 1. branch protection -------------------------------------------------
# GitHub refuses to enforce it on a private repo without Pro, so it lives here.
# CLAUDE.md: never push develop/master directly.
case "$branch" in
  develop|master)
    echo "pre-push: refusing to push directly to '$branch'. Branch first, then open a PR."
    fail=1
    ;;
esac

# --- 2. no-network guard --------------------------------------------------
# The local render is only identical because every runtime asset is vendored;
# a reintroduced CDN tag breaks that silently and only when offline.
if grep -qE 'fonts\.googleapis\.com|fonts\.gstatic\.com|unpkg\.com' index.html 2>/dev/null; then
  echo "pre-push: index.html references an external CDN."
  echo "          Fonts and React must load from ./fonts and ./vendor — see docs/LOCAL-SETUP.md."
  fail=1
fi

# --- 3. support.js is generated upstream ----------------------------------
# Only flags real modifications: --diff-filter=M skips the initial add, and the
# ref check keeps a fresh clone without origin/develop from failing outright.
if git rev-parse --verify -q origin/develop >/dev/null 2>&1; then
  if [ -n "$(git diff --name-only --diff-filter=M origin/develop...HEAD -- support.js)" ]; then
    echo "pre-push: support.js was modified. It is generated — do not edit."
    echo "          Use the window.__resources hook or local <script> tags instead."
    fail=1
  fi
fi

[ "$fail" -eq 0 ] || echo "pre-push: blocked. Override with --no-verify only if you know why."
exit "$fail"
