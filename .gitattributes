* text=auto eol=lf

# Byte-exact on purpose. vendor/*.js is validated against the SRI hashes declared
# in support.js, and support.js is generated upstream — line-ending conversion
# would change their bytes and invalidate that guarantee on a fresh clone.
vendor/** -text
support.js -text

# Windows shells mis-parse LF-only scripts, especially around goto labels and
# parenthesized blocks. Keep them CRLF regardless of the eol=lf default above.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.woff2 binary
*.woff  binary
*.png   binary
*.jpg   binary

# Generated; keep diffs quiet.
package-lock.json -diff
fonts/fonts.css   -diff
