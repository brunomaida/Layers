#!/bin/sh
# LAYERS pre-push gate. Install with: bash scripts/install-hooks.sh
#
# Git hooks are not versioned, so this lives in scripts/ and is copied into
# .git/hooks/ by the installer. Re-run the installer after cloning.

set -u
fail=0
branch=$(git rev-parse --abbrev-ref HEAD)

# 1. Branch protection. GitHub refuses to enforce it on a private repo without
#    Pro, so it is enforced here instead. CLAUDE.md: never push develop/master.
case "$branch" in
  develop|master)
    echo "pre-push: refusing to push directly to '$branch'."
    echo "          Branch first, then open a PR."
    fail=1
    ;;
esac

# 2. Changelog fragment required for work branches.
case "$branch" in
  feature/*|fix/*|refactor/*|simplification/*)
    if [ -z "$(ls changelog.d/*.md 2>/dev/null)" ]; then
      echo "pre-push: no changelog.d/<slug>.md fragment found."
      echo "          Run the changelog-draft skill before pushing '$branch'."
      fail=1
    fi
    ;;
esac

# 3. No-network guard. The local render is only identical because every runtime
#    asset is vendored; a reintroduced CDN tag silently breaks that offline.
if grep -qE 'fonts\.googleapis\.com|fonts\.gstatic\.com|unpkg\.com' index.html 2>/dev/null; then
  echo "pre-push: index.html references an external CDN."
  echo "          Fonts and React must load from ./fonts and ./vendor."
  echo "          See docs/LOCAL-SETUP.md."
  fail=1
fi

# 4. support.js is generated upstream and must not be edited here.
if ! git diff --quiet origin/develop...HEAD -- support.js 2>/dev/null; then
  echo "pre-push: support.js was modified. It is generated — do not edit."
  echo "          Use the window.__resources hook or local <script> tags instead."
  fail=1
fi

[ "$fail" -eq 0 ] || echo "pre-push: blocked. Override with --no-verify only if you know why."
exit "$fail"
